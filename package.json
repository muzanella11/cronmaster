{
  "name": "@nmcore/cronmaster",
  "version": "0.0.1-rc.39",
  "description": "Advanced cron job orchestration with rolling schedules and persistent storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzanella11/cronmaster.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "prepare:dist": "node scripts/prepare-dist.js",
    "prepare-build": "yarn lint && yarn format:check && yarn build",
    "build": "tsc -p tsconfig.build.json && yarn format:fix && yarn prepare:dist",
    "test": "jest --detectOpenHandles",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "example": "ts-node examples/index.ts"
  },
  "devDependencies": {
    "@types/cron": "^2.4.3",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cronstrue": "^3.9.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "moment-timezone": "^0.6.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
